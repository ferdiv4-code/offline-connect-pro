{
  "expo": {
    "name": "Offline Connect Pro",
    "slug": "offline-connect-pro",
    "scheme": "offlineconnectpro",
    "version": "2.4.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.offlineconnectpro.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Offline Connect Pro discovers nearby phones and exchanges messages, files and calls over their local Wi-Fi network.",
        "NSBonjourServices": [
          "_ocpro._tcp"
        ],
        "NSCameraUsageDescription": "Camera access is used for local video calls.",
        "NSMicrophoneUsageDescription": "Microphone access is used for local voice and video calls."
      }
    },
    "android": {
      "package": "com.offlineconnectpro.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "WAKE_LOCK",
        "VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#06182A"
      },
      "versionCode": 2440
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Offline Connect Pro to use the camera during local video calls.",
          "microphonePermission": "Allow Offline Connect Pro to use the microphone during local calls."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4105406776551148~9263229926"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06182A"
    }
  }
}
